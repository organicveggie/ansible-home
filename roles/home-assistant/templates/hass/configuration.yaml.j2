default_config:

homeassistant:
  name: "{{ hass_home_name }}"
  latitude: !secret home_latitude
  longitude: !secret home_longitude
  unit_system: "{{ hass_home_units }}"
  time_zone: !secret home_time_zone
  allowlist_external_dirs:
    - "/config"
  internal_url: "{{ _hass_docker_url }}"
  packages: !include_dir_named packages

http:
  use_x_forwarded_for: true
  trusted_proxies:
{{ _home_assistant_trusted_proxies | to_nice_yaml(indent=2, width=2147483647) | indent(4, first=True) }}

automation: !include automations.yaml
automation custom: !include_dir_merge_list automations
input_select: !include_dir_merge_named input_select
scene: !include scenes.yaml
# scene custom: !include_dir_merge_list scenes
script: !include scripts.yaml
script custom: !include_dir_merge_named scripts
template: !include_dir_merge_list templates

frontend:
  extra_module_url:
    - /www/community/lovelace-card-mod/card-mod.js

lovelace:
  mode: "storage"
  dashboards:
    quick-yaml:
      mode: "yaml"
      title: "Quick"
      icon: "mdi:clock-fast"
      show_in_sidebar: true
      filename: "dashboards/quick.yaml"
    hvac-yaml:
      mode: "yaml"
      title: "HVAC"
      icon: "mdi:hvac"
      show_in_sidebar: true
      filename: "dashboards/hvac.yaml"
