---
- name: Verify
  hosts: all
  gather_facts: false

  vars:
    {{ role_name }}_available_externally: true
    {{ role_name }}_extra_env:
      "_MOLECULE_TEST": "{{ role_name }} molecule test value"
    {{ role_name }}_extra_labels:
      "molecule-label-01": "molecule-value-01"
    {{ role_name }}_extra_networks:
      - name: "extra-network"
    {{ role_name }}_name: "{{ role_name }}-molecule"
    {{ role_name }}_network_aliases:
      - "zzz-molecule"
    {{ role_name }}_network_name: "molecule-test-network"
    {{ role_name }}_volume_name: "{{ role_name }}-molecule-volume"

  tasks:
    - name: "Verify volumes"
      ansible.builtin.include_tasks:
        file: "includes/verify-volume.yml"
      loop:
        - "{% raw %}{{{% endraw %} {{ role_name }}_volume_name {% raw %}}}{% endraw %}"
      loop_control:
        loop_var: "__molecule_volume_name"

    - name: Get info on container
      community.docker.docker_container_info:
        name: "{% raw %}{{{% endraw %} {{ role_name }}_name {% raw %}}}{% endraw %}"
      register: _container

    - name: Verify container exists
      ansible.builtin.assert:
        that:
          - _container.exists
          - _container["container"]["State"]["Status"] == "running"

    - name: Verify extra environment variables
      ansible.builtin.assert:
        that:
          - "__env in __all_env"
      vars:
        __all_env: "{% raw %}{{ _container['container']['Config']['Env'] }}{% endraw %}"
        __env: "_MOLECULE_TEST={% raw %}{{{% endraw %} {{ role_name }}_extra_env['_MOLECULE_TEST'] {% raw %}}}{% endraw %}"

    - name: Verify extra labels
      ansible.builtin.assert:
        that:
          - __all_labels["molecule-label-01"] is defined
          - __all_labels["molecule-label-01"] == {{ role_name }}_extra_labels["molecule-label-01"]
      vars:
        __all_labels: "{% raw %}{{ _container['container']['Config']['Labels'] }}{% endraw %}"

    - name: "Verify networks"
      ansible.builtin.include_tasks:
        file: "includes/verify-network.yml"
      loop:
        - "{% raw %}{{{% endraw %} {{ role_name }}_network_name {% raw %}}}{% endraw %}"
        - "{% raw %}{{{% endraw %} {{ role_name }}_extra_networks[0].name {% raw %}}}{% endraw %}"
      loop_control:
        loop_var: "__molecule_network_name"
      vars:
        __container_id: "{% raw %}{{ _container['container']['Id'] }}{% endraw %}"

    - name: "Verify default network aliases"
      ansible.builtin.assert:
        that:
          - __networks[{{ role_name }}_network_name]['Aliases'] is defined
          - __role_alias in __networks[{{ role_name }}_network_name]['Aliases']
      loop: "{% raw %}{{{% endraw %} {{ role_name }}_network_aliases {% raw %}}}{% endraw %}"
      loop_control:
        loop_var: "__role_alias"
      vars:
        __networks: "{% raw %}{{ _container['container']['NetworkSettings']['Networks'] }}{% endraw %}"
